# python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
.ipynb_checkpoints/

# data (see data/README.md — acquired separately, not redistributed)
data/*
!data/README.md
# exception: sirnamod_xgb_v1 is our own artifact (577 KB) — ships in-repo
!data/drive_weights/
data/drive_weights/*
!data/drive_weights/sirnamod_xgb_v1.joblib

# live real-data run outputs. These are in-progress while a run proceeds
# (partial per-epoch logs, per-seed reports); committing them mid-run would put
# half-finished numbers into history. The FINAL reviewed comparison tables are
# committed deliberately once a run completes -- see docs/REPRODUCE.md -- via an
# explicit `git add -f results/real_*/table_*.{json,md}` and the seed summary,
# not by tracking the whole working directory. The per-seed final_report.json and
# train_log.jsonl of completed runs are force-added too, because the figures read
# them (tests/test_figure_inputs_tracked.py checks that nothing they read is
# missing).
results/real_*/

# large artifacts (release via GitHub Releases / HuggingFace)
results/**/ckpt_*.pt
results/**/*.safetensors
vcpe_cache*.json.gz
p1_out/
p2_out/
p3_out/
l2_pretrain/

# local runtime
*.log
nohup.out
.tmp/

# script caches (auto-downloaded)
src/l2/9606.protein.info.*
src/efficacy/*_cache.json

# figure rasters are regenerated by tools/figures/make_all.py; the vectors and
# the legends/table/manifest are tracked because they are the submitted items
figures/*.png
figures/**/*.png
